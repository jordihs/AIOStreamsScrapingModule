<?xml version='1.0' encoding='UTF-8'?>
<addons>
    <addon id="script.aiostreamscraper" name="AIOStreams Scraper" version="0.1.0~beta13" provider-name="Jordihs">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.python.script" library="main.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">AIOStreams Scraper</summary>
            <description lang="en_GB">Provider-agnostic connector for AIOStreams</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
    <addon id="repository.aiostreamscraper" name="AIOStreams Scraper Repository" version="0.1.0~beta1" provider-name="Jordihs">
        <extension point="xbmc.addon.repository" name="AIOStreams Scraper Repository">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/jordihs/AIOStreamsScrapingModule/main/docs/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/jordihs/AIOStreamsScrapingModule/main/docs/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/jordihs/AIOStreamsScrapingModule/main/docs</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">AIOStreams Scraper Repository</summary>
            <description lang="en_GB">Add-on repository for AIOStreams Scraper. Install this once to get the addon plus automatic future updates.</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
</addons>