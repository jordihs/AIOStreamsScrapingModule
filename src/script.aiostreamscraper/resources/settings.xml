<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="Manifest URL">
        <setting id="manifest_url" type="text" label="AIOStreams Manifest URL" default="" />
    </category>
    <category label="AIOStreams Settings">
        <setting id="timeout" type="number" label="Search Timeout (seconds)" default="10" />
        <setting id="test_search_action" type="action" label="Run Test Search" action="RunScript(script.aiostreamscraper,test)" option="close" />
        <setting id="link_cocoscrapers_service" type="bool" label="Automatically re-link on Kodi startup" default="true" />
        <setting id="link_cocoscrapers_action" type="action" label="Link to CocoScrapers Now" action="RunScript(script.aiostreamscraper,link_cocoscrapers)" option="close" />
        <setting id="cocoscrapers_only_action" type="action" label="Make AIOStreams the Only CocoScrapers Source" action="RunScript(script.aiostreamscraper,cocoscrapers_only)" option="close" />
    </category>
</settings>
